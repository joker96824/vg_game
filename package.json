{
  "name": "vg_game",
  "version": "1.0.0",
  "description": "A cross-platform game application",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "concurrently \"vite\" \"electron .\"",
    "electron:build": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@mui/material": "^5.11.16",
    "@reduxjs/toolkit": "^1.9.5",
    "axios": "^0.27.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^7.2.9",
    "react-router-dom": "^6.8.2",
    "react-select": "^5.7.3",
    "react-swipeable": "^7.0.2"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.0.1",
    "@types/node": "^12.20.55",
    "@types/react": "^17.0.53",
    "@types/react-dom": "^17.0.26",
    "@vitejs/plugin-react": "^1.3.2",
    "autoprefixer": "^10.4.14",
    "concurrently": "^6.5.1",
    "electron": "^11.5.0",
    "electron-builder": "^22.14.13",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.2.7",
    "typescript": "^4.9.5",
    "vite": "^2.9.15",
    "vite-plugin-svgr": "^4.3.0"
  },
  "build": {
    "appId": "com.vg.game",
    "productName": "VG Game",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
