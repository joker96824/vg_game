{
  "name": "vg_game",
  "version": "1.0.0",
  "description": "A cross-platform game application",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "concurrently \"vite\" \"electron .\"",
    "electron:build": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.5",
    "axios": "^0.27.2",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-redux": "^7.2.9"
  },
  "devDependencies": {
    "@types/node": "^12.20.55",
    "@types/react": "^17.0.53",
    "@types/react-dom": "^17.0.19",
    "@vitejs/plugin-react": "^1.3.2",
    "autoprefixer": "^10.4.14",
    "concurrently": "^6.5.1",
    "electron": "^11.5.0",
    "electron-builder": "^22.14.13",
    "postcss": "^8.4.24",
    "tailwindcss": "^2.2.19",
    "typescript": "^4.9.5",
    "vite": "^2.9.15"
  },
  "build": {
    "appId": "com.vg.game",
    "productName": "VG Game",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
